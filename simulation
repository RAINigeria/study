<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VROS — Visual Robotics Operating System</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;font-family:'Segoe UI',system-ui,sans-serif;background:#0d0d12;color:#e8e8e8}
#app{display:flex;flex-direction:column;height:100vh}

/* TOP BAR */
#topbar{display:flex;align-items:center;gap:8px;padding:6px 14px;background:#141418;border-bottom:1px solid #2a2a35;flex-shrink:0;min-height:42px}
.logo{font-weight:800;font-size:16px;color:#3987e5;letter-spacing:2px}
.logo-sub{font-size:10px;color:#555;margin-left:2px}
.tabs{display:flex;gap:2px;margin-left:12px}
.tab{padding:4px 12px;border-radius:6px;font-size:11px;cursor:pointer;color:#888;border:none;background:transparent;transition:all .15s;white-space:nowrap}
.tab.active{background:#1e1e28;color:#e8e8e8;border:1px solid #2a2a35}
.tab:hover:not(.active){background:#1a1a22;color:#ccc}
.run-badge{margin-left:auto;font-size:10px;padding:3px 8px;border-radius:10px;background:#0f2a12;color:#1baf7a;border:1px solid #1baf7a44;font-family:monospace}

/* LAYOUT */
#main{display:flex;flex:1;overflow:hidden}
#sidebar{width:190px;background:#141418;border-right:1px solid #2a2a35;display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0}
#sidebar::-webkit-scrollbar{width:4px}
#sidebar::-webkit-scrollbar-thumb{background:#2a2a35;border-radius:2px}
.s-section{border-bottom:1px solid #1e1e28;padding:8px 10px}
.s-title{font-size:9px;color:#555;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.row{display:flex;align-items:center;gap:6px;margin-bottom:5px;font-size:11px}
.row label{flex:1;color:#999}
.row input[type=range]{flex:1;height:3px;accent-color:#3987e5}
.val{min-width:30px;text-align:right;font-size:10px;color:#3987e5;font-family:monospace}
.btn{padding:3px 8px;border-radius:4px;border:1px solid #2a2a35;background:#1e1e28;color:#ccc;font-size:10px;cursor:pointer;transition:all .12s}
.btn:hover{background:#2a2a35;color:#fff}
.btn.on{background:#3987e5;color:#fff;border-color:#3987e5}
.btn-group{display:flex;flex-wrap:wrap;gap:3px}
.algo-btn{padding:3px 7px;border-radius:4px;border:1px solid #2a2a35;background:#1e1e28;color:#888;font-size:10px;cursor:pointer;transition:all .12s}
.algo-btn.active{background:#1a2a3e;color:#3987e5;border-color:#3987e5}
.algo-btn:hover:not(.active){background:#222;color:#ccc}
select{width:100%;background:#1e1e28;color:#ccc;border:1px solid #2a2a35;border-radius:4px;font-size:10px;padding:3px 5px}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}
.stat{background:#1e1e28;border-radius:4px;padding:4px 6px;border:1px solid #1a1a24}
.sk{font-size:9px;color:#555}
.sv{font-size:12px;font-weight:600;color:#e8e8e8;font-family:monospace}

/* CANVAS */
#canvas-area{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative}
#sim{display:block;width:100%;flex:1;cursor:crosshair;background:#0d0d12}

/* BOTTOM */
#bottom{height:155px;background:#141418;border-top:1px solid #2a2a35;display:flex;flex-shrink:0}
.bp{flex:1;padding:8px 10px;border-right:1px solid #1e1e28;overflow:hidden;display:flex;flex-direction:column}
.bp:last-child{border-right:none}
.bp-title{font-size:9px;color:#555;text-transform:uppercase;letter-spacing:.7px;margin-bottom:4px;flex-shrink:0}
#chart-canvas{width:100%;flex:1}
#matrix-display{font-size:9px;font-family:monospace;color:#999;line-height:1.7}
.mrow{display:flex;gap:3px;margin-bottom:2px}
.mv{background:#1e1e28;border-radius:3px;padding:1px 5px;min-width:48px;text-align:center;font-size:9px;color:#3987e5;border:1px solid #1a1a24}
.ee-info{margin-top:4px;font-size:10px;color:#1baf7a;font-family:monospace}
.mu-info{font-size:10px;color:#eda100;font-family:monospace}

/* LEGEND */
#legend{display:flex;gap:12px;flex-wrap:wrap;font-size:9px;color:#666;padding:4px 10px;border-top:1px solid #1a1a24;flex-shrink:0;background:#141418}
.li{display:flex;align-items:center;gap:3px}
.ld{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* HELP */
#help{font-size:10px;color:#444;padding:3px 10px;border-top:1px solid #141418;text-align:center;flex-shrink:0;background:#0d0d12}

/* MODULE PANELS */
.mpanel{display:none}
.mpanel.active{display:block}

/* MICRO CONTROLS */
.micro-row{display:flex;gap:3px;margin-bottom:5px}
</style>
</head>
<body>
<div id="app">
  <div id="topbar">
    <span class="logo">VROS</span><span class="logo-sub">Visual Robotics OS</span>
    <div class="tabs">
      <button class="tab active" onclick="switchModule('planner')">🗺 Path Planning</button>
      <button class="tab" onclick="switchModule('pid')">📈 PID Lab</button>
      <button class="tab" onclick="switchModule('kinematics')">🦾 Kinematics</button>
      <button class="tab" onclick="switchModule('swarm')">🐝 Swarm</button>
      <button class="tab" onclick="switchModule('slam')">🗺 SLAM</button>
    </div>
    <span class="run-badge" id="runbadge">▶ RUNNING</span>
  </div>

  <div id="main">
    <div id="sidebar">

      <!-- PLANNER PANEL -->
      <div id="panel-planner" class="mpanel active">
        <div class="s-section">
          <div class="s-title">Algorithm</div>
          <div class="btn-group">
            <button class="algo-btn active" id="alg-astar" onclick="setAlgo('astar')">A*</button>
            <button class="algo-btn" id="alg-dijkstra" onclick="setAlgo('dijkstra')">Dijkstra</button>
            <button class="algo-btn" id="alg-rrt" onclick="setAlgo('rrt')">RRT</button>
            <button class="algo-btn" id="alg-rrtstar" onclick="setAlgo('rrtstar')">RRT*</button>
            <button class="algo-btn" id="alg-theta" onclick="setAlgo('theta')">Theta*</button>
            <button class="algo-btn" id="alg-pfield" onclick="setAlgo('pfield')">Pot.Field</button>
          </div>
        </div>
        <div class="s-section">
          <div class="s-title">Algorithm Microscope</div>
          <div class="micro-row">
            <button class="btn" onclick="step(-20)">⏮</button>
            <button class="btn" id="playbtn" onclick="togglePause()">⏸</button>
            <button class="btn" onclick="step(20)">⏭</button>
            <button class="btn" onclick="resetAll()">↺</button>
          </div>
          <div class="row"><label>Speed</label><input type="range" min="1" max="30" value="10" oninput="simSpeed=+this.value;this.nextElementSibling.textContent=this.value+'x'"><span class="val">10x</span></div>
          <div class="row"><label>Frame</label><span class="val" id="frame-ctr">0</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Environment</div>
          <div class="btn-group">
            <button class="btn" onclick="addWalls()">+ Walls</button>
            <button class="btn" onclick="clearWalls()">Clear</button>
            <button class="btn" onclick="randomEnv()">Random</button>
            <button class="btn" onclick="addDynAgent()">+ Agent</button>
          </div>
        </div>
        <div class="s-section">
          <div class="s-title">Robot</div>
          <div class="row"><label>Speed</label><input type="range" min="1" max="12" value="4" oninput="rSpeed=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">4</span></div>
          <div class="row"><label>Size</label><input type="range" min="5" max="22" value="10" oninput="rRadius=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">10</span></div>
          <div class="row"><label>LiDAR</label><input type="checkbox" checked onchange="showLidar=this.checked"></div>
        </div>
        <div class="s-section">
          <div class="s-title">Visualisation</div>
          <div class="row"><label>Explored nodes</label><input type="checkbox" checked onchange="showExp=this.checked"></div>
          <div class="row"><label>Frontier</label><input type="checkbox" checked onchange="showFront=this.checked"></div>
          <div class="row"><label>Search tree</label><input type="checkbox" checked onchange="showTree=this.checked"></div>
          <div class="row"><label>Heatmap</label><input type="checkbox" onchange="showHeat=this.checked"></div>
          <div class="row"><label>Safety ring</label><input type="checkbox" checked onchange="showSafety=this.checked"></div>
        </div>
      </div>

      <!-- PID PANEL -->
      <div id="panel-pid" class="mpanel">
        <div class="s-section">
          <div class="s-title">Controller</div>
          <select onchange="pid.mode=this.value;resetPID()">
            <option value="pid">PID</option>
            <option value="p">P only</option>
            <option value="pd">PD</option>
            <option value="pi">PI</option>
            <option value="lqr">LQR (approx)</option>
          </select>
        </div>
        <div class="s-section">
          <div class="s-title">Gains</div>
          <div class="row"><label>Kp</label><input type="range" min="0" max="8" step="0.05" value="2.0" oninput="pid.kp=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(2)"><span class="val">2.00</span></div>
          <div class="row"><label>Ki</label><input type="range" min="0" max="3" step="0.01" value="0.15" oninput="pid.ki=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(2)"><span class="val">0.15</span></div>
          <div class="row"><label>Kd</label><input type="range" min="0" max="3" step="0.01" value="0.5" oninput="pid.kd=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(2)"><span class="val">0.50</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Setpoint</div>
          <div class="row"><label>Target</label><input type="range" min="-0.9" max="0.9" step="0.05" value="0.6" oninput="pid.sp=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(2);resetPIDMeta()"><span class="val">0.60</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Disturbance</div>
          <div class="btn-group">
            <button class="btn" onclick="pid.dist=0.8;setTimeout(()=>pid.dist=0,300)">Push +</button>
            <button class="btn" onclick="pid.dist=-0.8;setTimeout(()=>pid.dist=0,300)">Push −</button>
            <button class="btn" id="noisebtn" onclick="pid.noisy=!pid.noisy;this.classList.toggle('on')">Noise</button>
          </div>
        </div>
        <div class="s-section">
          <div class="s-title">Live Metrics</div>
          <div class="stat-grid">
            <div class="stat"><div class="sk">Overshoot</div><div class="sv" id="p-ov">0.0%</div></div>
            <div class="stat"><div class="sk">Settle (s)</div><div class="sv" id="p-st">—</div></div>
            <div class="stat"><div class="sk">SS Error</div><div class="sv" id="p-ss">0.000</div></div>
            <div class="stat"><div class="sk">Rise (s)</div><div class="sv" id="p-rs">—</div></div>
          </div>
        </div>
      </div>

      <!-- KINEMATICS PANEL -->
      <div id="panel-kinematics" class="mpanel">
        <div class="s-section">
          <div class="s-title">Robot Type</div>
          <select onchange="kin.type=this.value;resetKin()">
            <option value="2r">2R Planar</option>
            <option value="3r">3R Planar</option>
            <option value="scara">SCARA (4R)</option>
          </select>
        </div>
        <div class="s-section">
          <div class="s-title">Joint Angles</div>
          <div class="row"><label>θ₁</label><input type="range" min="-180" max="180" value="30" oninput="kin.q[0]=+this.value*Math.PI/180;this.nextElementSibling.textContent=this.value+'°'"><span class="val">30°</span></div>
          <div class="row"><label>θ₂</label><input type="range" min="-160" max="160" value="60" oninput="kin.q[1]=+this.value*Math.PI/180;this.nextElementSibling.textContent=this.value+'°'"><span class="val">60°</span></div>
          <div class="row" id="q3r"><label>θ₃</label><input type="range" min="-160" max="160" value="-40" oninput="kin.q[2]=+this.value*Math.PI/180;this.nextElementSibling.textContent=this.value+'°'"><span class="val">-40°</span></div>
          <div class="row" id="q4r" style="display:none"><label>θ₄</label><input type="range" min="-160" max="160" value="20" oninput="kin.q[3]=+this.value*Math.PI/180;this.nextElementSibling.textContent=this.value+'°'"><span class="val">20°</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Link Lengths</div>
          <div class="row"><label>L₁</label><input type="range" min="40" max="130" value="85" oninput="kin.L[0]=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">85</span></div>
          <div class="row"><label>L₂</label><input type="range" min="30" max="110" value="65" oninput="kin.L[1]=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">65</span></div>
          <div class="row" id="L3r"><label>L₃</label><input type="range" min="20" max="90" value="45" oninput="kin.L[2]=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">45</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Visualise</div>
          <div class="row"><label>Workspace</label><input type="checkbox" checked onchange="kin.ws=this.checked"></div>
          <div class="row"><label>Frames</label><input type="checkbox" checked onchange="kin.fr=this.checked"></div>
          <div class="row"><label>Jacobian ellipsoid</label><input type="checkbox" checked onchange="kin.jac=this.checked"></div>
          <div class="row"><label>Trajectory</label><input type="checkbox" checked onchange="kin.traj=this.checked"></div>
          <div class="row"><label>Auto-animate</label><input type="checkbox" checked onchange="kin.anim=this.checked"></div>
        </div>
      </div>

      <!-- SWARM PANEL -->
      <div id="panel-swarm" class="mpanel">
        <div class="s-section">
          <div class="s-title">Swarm Size</div>
          <div class="btn-group">
            <button class="btn on" id="sw10" onclick="initSwarm(10)">10</button>
            <button class="btn" id="sw50" onclick="initSwarm(50)">50</button>
            <button class="btn" id="sw100" onclick="initSwarm(100)">100</button>
            <button class="btn" id="sw300" onclick="initSwarm(300)">300</button>
          </div>
        </div>
        <div class="s-section">
          <div class="s-title">Behaviour</div>
          <select onchange="sw.mode=this.value">
            <option value="flock">Flocking (Reynolds)</option>
            <option value="leader">Leader-Follower</option>
            <option value="formation">Formation Grid</option>
            <option value="explore">Exploration</option>
          </select>
        </div>
        <div class="s-section">
          <div class="s-title">Reynolds Rules</div>
          <div class="row"><label>Separation</label><input type="range" min="0" max="4" step="0.1" value="1.5" oninput="sw.sep=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(1)"><span class="val">1.5</span></div>
          <div class="row"><label>Alignment</label><input type="range" min="0" max="4" step="0.1" value="1.0" oninput="sw.ali=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(1)"><span class="val">1.0</span></div>
          <div class="row"><label>Cohesion</label><input type="range" min="0" max="4" step="0.1" value="0.8" oninput="sw.coh=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(1)"><span class="val">0.8</span></div>
          <div class="row"><label>Max speed</label><input type="range" min="0.5" max="5" step="0.1" value="2" oninput="sw.maxspd=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(1)"><span class="val">2.0</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Display</div>
          <div class="row"><label>Velocity arrows</label><input type="checkbox" checked onchange="sw.vel=this.checked"></div>
          <div class="row"><label>Trails</label><input type="checkbox" onchange="sw.trails=this.checked"></div>
          <div class="row"><label>Perception ring</label><input type="checkbox" onchange="sw.rings=this.checked"></div>
        </div>
      </div>

      <!-- SLAM PANEL -->
      <div id="panel-slam" class="mpanel">
        <div class="s-section">
          <div class="s-title">Algorithm</div>
          <select onchange="slam.algo=this.value">
            <option value="pf">Particle Filter (MCL)</option>
            <option value="ekf">EKF-SLAM</option>
            <option value="graph">Graph-Based</option>
          </select>
        </div>
        <div class="s-section">
          <div class="s-title">Sensor Model</div>
          <div class="row"><label>Range (px)</label><input type="range" min="50" max="250" value="130" oninput="slam.range=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">130</span></div>
          <div class="row"><label>Noise σ</label><input type="range" min="0" max="15" step="0.5" value="3" oninput="slam.noise=+this.value;this.nextElementSibling.textContent=(+this.value).toFixed(1)"><span class="val">3.0</span></div>
          <div class="row"><label>Particles</label><input type="range" min="10" max="300" step="10" value="80" oninput="slam.nP=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">80</span></div>
          <div class="row"><label>Beams</label><input type="range" min="8" max="64" step="8" value="24" oninput="slam.beams=+this.value;this.nextElementSibling.textContent=this.value"><span class="val">24</span></div>
        </div>
        <div class="s-section">
          <div class="s-title">Display Layers</div>
          <div class="row"><label>Particle cloud</label><input type="checkbox" checked onchange="slam.showP=this.checked"></div>
          <div class="row"><label>Occupancy grid</label><input type="checkbox" checked onchange="slam.showG=this.checked"></div>
          <div class="row"><label>True walls</label><input type="checkbox" onchange="slam.showW=this.checked"></div>
          <div class="row"><label>Pose path</label><input type="checkbox" checked onchange="slam.showPth=this.checked"></div>
          <div class="row"><label>LiDAR beams</label><input type="checkbox" checked onchange="slam.showB=this.checked"></div>
        </div>
      </div>

    </div><!-- /sidebar -->

    <div id="canvas-area">
      <canvas id="sim"></canvas>
      <div id="legend">
        <span class="li"><span class="ld" style="background:#3987e5"></span>Explored</span>
        <span class="li"><span class="ld" style="background:#eda100"></span>Frontier</span>
        <span class="li"><span class="ld" style="background:#1baf7a"></span>Path</span>
        <span class="li"><span class="ld" style="background:#e34948"></span>Obstacle</span>
        <span class="li"><span class="ld" style="background:#fff"></span>Robot</span>
        <span class="li"><span class="ld" style="background:#c84fc8"></span>Goal</span>
      </div>
      <div id="help">Click canvas → set goal &nbsp;|&nbsp; Right-click → add wall &nbsp;|&nbsp; Drag → paint obstacles</div>
    </div>
  </div><!-- /main -->

  <div id="bottom">
    <div class="bp">
      <div class="bp-title">Algorithm Status</div>
      <div style="font-size:10px;line-height:1.8;color:#999;font-family:monospace">
        <div>Algo: <span style="color:#3987e5" id="b-algo">A*</span></div>
        <div>Explored: <span style="color:#3987e5" id="b-exp">0</span></div>
        <div>Path: <span style="color:#1baf7a" id="b-path">—</span></div>
        <div>Time: <span style="color:#eda100" id="b-time">—</span></div>
        <div>Status: <span style="color:#1baf7a" id="b-status">Ready</span></div>
      </div>
    </div>
    <div class="bp">
      <div class="bp-title">Live Metrics</div>
      <div class="stat-grid">
        <div class="stat"><div class="sk">X pos</div><div class="sv" id="m-x">0</div></div>
        <div class="stat"><div class="sk">Y pos</div><div class="sv" id="m-y">0</div></div>
        <div class="stat"><div class="sk">Heading</div><div class="sv" id="m-h">0°</div></div>
        <div class="stat"><div class="sk">Speed</div><div class="sv" id="m-s">0</div></div>
        <div class="stat"><div class="sk">Error</div><div class="sv" id="m-e">0</div></div>
        <div class="stat"><div class="sk">FPS</div><div class="sv" id="m-fps">0</div></div>
      </div>
    </div>
    <div class="bp" style="flex:2">
      <div class="bp-title" id="chart-label">Signal Plot</div>
      <canvas id="chart-canvas"></canvas>
    </div>
    <div class="bp">
      <div class="bp-title">FK / Jacobian</div>
      <div id="matrix-display">
        <div class="mrow"><span class="mv" id="j00">—</span><span class="mv" id="j01">—</span><span class="mv" id="j02">—</span></div>
        <div class="mrow"><span class="mv" id="j10">—</span><span class="mv" id="j11">—</span><span class="mv" id="j12">—</span></div>
        <div class="ee-info" id="ee-pos">EE: (—, —)</div>
        <div class="mu-info" id="manip">μ = —</div>
      </div>
    </div>
  </div>
</div>

<script>
// ===================== GLOBALS =====================
const sim = document.getElementById('sim');
const ctx = sim.getContext('2d');
const cc = document.getElementById('chart-canvas');
const cctx = cc.getContext('2d');

let W, H, COLS, ROWS;
const CELL = 18;
let module = 'planner';
let paused = false;
let simSpeed = 10;
let rSpeed = 4, rRadius = 10;
let showExp = true, showFront = true, showTree = true, showHeat = false, showLidar = true, showSafety = true;
let frameStep = 0;
let fps = 0, fc = 0, ft = 0;

// ===================== RESIZE =====================
function resize() {
  const area = document.getElementById('canvas-area');
  const leg = document.getElementById('legend');
  const help = document.getElementById('help');
  sim.width = area.clientWidth;
  sim.height = area.clientHeight - leg.offsetHeight - help.offsetHeight;
  W = sim.width; H = sim.height;
  COLS = Math.floor(W / CELL); ROWS = Math.floor(H / CELL);
  cc.width = cc.parentElement.clientWidth - 20;
  cc.height = cc.parentElement.clientHeight - 24;
  if (module === 'planner') initPlanner(false);
  if (module === 'kinematics') { /* no reset needed */ }
}
window.addEventListener('resize', resize);

