function mkLegend(items) {
  return items.map(([c,l]) => `<span class="li"><span class="ld" style="background:${c}"></span>${l}</span>`).join('');
}

// ===================== PATH PLANNER =====================
let grid, obstacles = [], path = [], explored = [], frontier = [], treeEdges = [];
let robot = {x:3, y:3, angle:0, vx:0, vy:0};
let goal = {x:0, y:0};
let pathIdx = 0, planDone = false, planning = false;
let algo = 'astar';
let hmap = [];
let dynAgents = [];

function initPlanner(full) {
  COLS = Math.floor(W/CELL); ROWS = Math.floor(H/CELL);
  grid = Array.from({length:ROWS}, () => new Array(COLS).fill(0));
  robot = {x:3, y:3, angle:0, vx:0, vy:0};
  goal = {x:COLS-4, y:ROWS-4};
  path=[]; explored=[]; frontier=[]; treeEdges=[]; pathIdx=0; planDone=false;
  hmap = Array.from({length:ROWS}, () => new Array(COLS).fill(Infinity));
  if (full) { dynAgents=[]; randomEnv(); }
  plan();
}

function setAlgo(a) {
  algo = a;
  document.querySelectorAll('.algo-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('alg-'+a).classList.add('active');
  document.getElementById('b-algo').textContent = {astar:'A*',dijkstra:'Dijkstra',rrt:'RRT',rrtstar:'RRT*',theta:'Theta*',pfield:'Potential Field'}[a];
  plan();
}

function randomEnv() {
  obstacles = [];
  for (let i = 0; i < 10; i++) {
    const ox = 3 + Math.floor(Math.random()*(COLS-6));
    const oy = 3 + Math.floor(Math.random()*(ROWS-6));
    const ow = 2 + Math.floor(Math.random()*6);
    const oh = 1 + Math.floor(Math.random()*4);
    for (let dx=0; dx<ow; dx++) for (let dy=0; dy<oh; dy++) {
      const nx=ox+dx, ny=oy+dy;
      if (nx<COLS && ny<ROWS
        && !(nx>=robot.x-1 && nx<=robot.x+1 && ny>=robot.y-1 && ny<=robot.y+1)
        && !(nx>=goal.x-1 && nx<=goal.x+1 && ny>=goal.y-1 && ny<=goal.y+1))
        obstacles.push({x:nx, y:ny});
    }
  }
  buildGrid(); plan();
}

function buildGrid() {
  grid = Array.from({length:ROWS}, () => new Array(COLS).fill(0));
  obstacles.forEach(o => { if(o.x>=0&&o.x<COLS&&o.y>=0&&o.y<ROWS) grid[o.y][o.x]=1; });
}

function addWalls() {
  const cx=Math.floor(COLS/2)+Math.floor(Math.random()*8-4);
  const cy=Math.floor(ROWS/2)+Math.floor(Math.random()*6-3);
  for(let dx=0;dx<4;dx++) for(let dy=0;dy<2;dy++) obstacles.push({x:cx+dx,y:cy+dy});
  buildGrid(); plan();
}

function clearWalls() { obstacles=[]; dynAgents=[]; buildGrid(); plan(); }

function addDynAgent() {
  dynAgents.push({x:Math.random()*COLS, y:Math.random()*ROWS, vx:(Math.random()-.5)*.4, vy:(Math.random()-.5)*.4, r:0.5});
}

function plan() {
  if(planning) return;
  planning = true; planDone = false;
  path=[]; explored=[]; frontier=[]; treeEdges=[]; pathIdx=0;
  frameStep = 0;
  document.getElementById('b-status').textContent='Planning...';
  document.getElementById('b-status').style.color='#eda100';
  const t0=performance.now();

  if(algo==='rrt'||algo==='rrtstar') runRRT(algo==='rrtstar');
  else if(algo==='pfield') runPotField();
  else runGridSearch();

  const dt=performance.now()-t0;
  document.getElementById('b-time').textContent=dt.toFixed(1)+'ms';
  document.getElementById('b-exp').textContent=explored.length;
  document.getElementById('b-path').textContent=path.length?path.length+' nodes':'No path';
  document.getElementById('b-status').textContent=path.length?'Path found ✓':'No path found';
  document.getElementById('b-status').style.color=path.length?'#1baf7a':'#e34948';
  planning=false; planDone=true; pathIdx=0;
}

function heur(a,b) {
  if(algo==='dijkstra') return 0;
  return Math.sqrt((a.x-b.x)**2+(a.y-b.y)**2);
}

function runGridSearch() {
  const s={x:Math.round(robot.x),y:Math.round(robot.y)};
  const e={x:Math.round(goal.x),y:Math.round(goal.y)};
  const key=n=>`${n.x},${n.y}`;
  const open=[{...s,g:0,h:heur(s,e),f:heur(s,e),par:null}];
  const closed=new Set();
  const g={[key(s)]:0};
  explored=[]; frontier=[]; treeEdges=[];
  const dirs=[{x:1,y:0},{x:-1,y:0},{x:0,y:1},{x:0,y:-1},{x:1,y:1},{x:-1,y:1},{x:1,y:-1},{x:-1,y:-1}];
  let it=0;
  while(open.length && it<5000) {
    it++;
    open.sort((a,b)=>a.f-b.f);
    const cur=open.shift();
    if(closed.has(key(cur))) continue;
    closed.add(key(cur));
    explored.push({x:cur.x,y:cur.y,h:cur.h});
    if(cur.y<ROWS&&cur.x<COLS) hmap[cur.y][cur.x]=cur.h;
    if(cur.x===e.x&&cur.y===e.y){
      path=[]; let c=cur;
      while(c){path.unshift({x:c.x,y:c.y});c=c.par;}
      return;
    }
    for(const d of dirs){
      const nx=cur.x+d.x,ny=cur.y+d.y;
      if(nx<0||ny<0||nx>=COLS||ny>=ROWS||grid[ny][nx]) continue;
      const nk=`${nx},${ny}`;
      if(closed.has(nk)) continue;
      const ng=g[key(cur)]+(Math.abs(d.x)+Math.abs(d.y)>1?1.414:1);
      if(ng<(g[nk]||Infinity)){
        g[nk]=ng;
        const h=heur({x:nx,y:ny},e);
        open.push({x:nx,y:ny,g:ng,h,f:ng+h,par:cur});
        frontier.push({x:nx,y:ny});
        treeEdges.push({x1:cur.x,y1:cur.y,x2:nx,y2:ny});
      }
    }
  }
}

function runRRT(star) {
  const s={x:Math.round(robot.x),y:Math.round(robot.y)};
  const e={x:Math.round(goal.x),y:Math.round(goal.y)};
  const nodes=[{x:s.x,y:s.y,par:null,cost:0}];
  explored=[]; treeEdges=[]; frontier=[]; path=[];
  const step=4, goalBias=0.12, maxIt=1200;
  for(let i=0;i<maxIt;i++){
    let rx,ry;
    if(Math.random()<goalBias){rx=e.x;ry=e.y;}
    else{rx=Math.random()*COLS;ry=Math.random()*ROWS;}
    let near=nodes[0],md=Infinity;
    nodes.forEach(n=>{const d=(n.x-rx)**2+(n.y-ry)**2;if(d<md){md=d;near=n;}});
    const ang=Math.atan2(ry-near.y,rx-near.x);
    const nx=near.x+Math.cos(ang)*step,ny=near.y+Math.sin(ang)*step;
    if(nx<1||ny<1||nx>COLS-1||ny>ROWS-1) continue;
    let blocked=false;
    for(let t=0;t<=10;t++){
      const cx=Math.round(near.x+(nx-near.x)*t/10),cy=Math.round(near.y+(ny-near.y)*t/10);
      if(cx>=0&&cy>=0&&cx<COLS&&cy<ROWS&&grid[cy][cx]){blocked=true;break;}
    }
    if(blocked) continue;
    let par=near,cost=near.cost+step;
    if(star){
      const r2=step*3;
      nodes.forEach(n=>{const d=Math.sqrt((n.x-nx)**2+(n.y-ny)**2);if(d<r2&&n.cost+d<cost){par=n;cost=n.cost+d;}});
    }
    const nn={x:nx,y:ny,par,cost};
    nodes.push(nn);
    treeEdges.push({x1:par.x,y1:par.y,x2:nx,y2:ny});
    explored.push({x:Math.round(nx),y:Math.round(ny),h:Math.sqrt((nx-e.x)**2+(ny-e.y)**2)});
    if(Math.sqrt((nx-e.x)**2+(ny-e.y)**2)<step+1){
      path=[]; let c=nn;
      while(c){path.unshift({x:c.x,y:c.y});c=c.par;}
      path.push(e); return;
    }
  }
}

function runPotField() {
  const s={x:Math.round(robot.x),y:Math.round(robot.y)};
  const e={x:Math.round(goal.x),y:Math.round(goal.y)};
  path=[{...s}]; explored=[]; treeEdges=[]; frontier=[];
  let cx=s.x,cy=s.y;
  const ka=4,kr=250,d0=5;
  for(let it=0;it<800;it++){
    const dd=Math.sqrt((cx-e.x)**2+(cy-e.y)**2);
    if(dd<1.5){path.push(e);return;}
    let fx=(e.x-cx)/dd*ka,fy=(e.y-cy)/dd*ka;
    obstacles.forEach(o=>{
      const d=Math.sqrt((cx-o.x)**2+(cy-o.y)**2);
      if(d<d0&&d>0.01){const rep=kr*(1/d-1/d0)/(d*d);fx+=(cx-o.x)/d*rep;fy+=(cy-o.y)/d*rep;}
    });
    const mag=Math.sqrt(fx**2+fy**2);
    if(mag>0.001){cx+=fx/mag*0.5;cy+=fy/mag*0.5;}
    cx=Math.max(0,Math.min(COLS-1,cx)); cy=Math.max(0,Math.min(ROWS-1,cy));
    if(it%2===0){path.push({x:cx,y:cy});explored.push({x:Math.round(cx),y:Math.round(cy),h:dd});}
  }
}

function moveRobot() {
  if(!path.length||pathIdx>=path.length-1){robot.vx*=0.88;robot.vy*=0.88;return;}
  const tgt=path[Math.min(pathIdx+2,path.length-1)];
  const dx=tgt.x-robot.x,dy=tgt.y-robot.y,dist=Math.sqrt(dx**2+dy**2);
  if(dist<0.5){pathIdx++;return;}
  const spd=rSpeed*0.035;
  robot.vx=dx/dist*spd; robot.vy=dy/dist*spd;
  robot.x+=robot.vx; robot.y+=robot.vy;
  robot.angle=Math.atan2(robot.vy,robot.vx);
  document.getElementById('m-x').textContent=(robot.x*CELL).toFixed(0);
  document.getElementById('m-y').textContent=(robot.y*CELL).toFixed(0);
  document.getElementById('m-h').textContent=(robot.angle*180/Math.PI).toFixed(0)+'°';
  document.getElementById('m-s').textContent=spd.toFixed(3);
  document.getElementById('m-e').textContent=dist.toFixed(2);
  if(pathIdx>=path.length-1){
    goal={x:3+Math.floor(Math.random()*(COLS-6)),y:3+Math.floor(Math.random()*(ROWS-6))};
    if(goal.y<ROWS&&goal.x<COLS&&!grid[goal.y][goal.x]) plan();
  }
}

function drawPlanner() {
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d0d12'; ctx.fillRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(255,255,255,0.025)'; ctx.lineWidth=0.5;
  for(let x=0;x<W;x+=CELL){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=0;y<H;y+=CELL){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  // Heatmap
  if(showHeat){
    const maxH=Math.max(...hmap.flat().filter(v=>v<Infinity))||1;
    for(let r=0;r<ROWS;r++) for(let c2=0;c2<COLS;c2++){
      if(hmap[r][c2]<Infinity){
        const t=hmap[r][c2]/maxH;
        ctx.fillStyle=`rgba(${Math.round(t*180)},${Math.round((1-t)*80)},200,0.12)`;
        ctx.fillRect(c2*CELL,r*CELL,CELL,CELL);
      }
    }
  }
  // Obstacles
  obstacles.forEach(o=>{
    ctx.fillStyle='#c0302e';
    ctx.fillRect(o.x*CELL+1,o.y*CELL+1,CELL-2,CELL-2);
    ctx.fillStyle='rgba(227,73,72,0.3)';
    ctx.fillRect(o.x*CELL,o.y*CELL,CELL,CELL);
  });
  // Tree
  if(showTree){
    ctx.strokeStyle='rgba(57,135,229,0.18)'; ctx.lineWidth=0.6;
    treeEdges.forEach(e=>{
      ctx.beginPath();
      ctx.moveTo(e.x1*CELL+CELL/2,e.y1*CELL+CELL/2);
      ctx.lineTo(e.x2*CELL+CELL/2,e.y2*CELL+CELL/2);
      ctx.stroke();
    });
  }
  // Explored
  if(showExp){
    const limit=frameStep>0?frameStep:explored.length;
    explored.slice(0,limit).forEach(e=>{
      ctx.fillStyle='rgba(57,135,229,0.22)';
      ctx.fillRect(e.x*CELL+2,e.y*CELL+2,CELL-4,CELL-4);
    });
  }
  // Frontier
  if(showFront){
    const limit=frameStep>0?frameStep:frontier.length;
    frontier.slice(0,limit).forEach(f=>{
      ctx.fillStyle='rgba(237,161,0,0.3)';
      ctx.fillRect(f.x*CELL+1,f.y*CELL+1,CELL-2,CELL-2);
    });
  }
  // Path
  if(path.length>1){
    ctx.strokeStyle='#1baf7a'; ctx.lineWidth=3; ctx.lineJoin='round'; ctx.lineCap='round';
    ctx.beginPath();
    path.forEach((p,i)=>{const px=p.x*CELL+CELL/2,py=p.y*CELL+CELL/2;i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);});
    ctx.stroke();
    // animated dashes
    ctx.strokeStyle='rgba(255,255,255,0.25)'; ctx.lineWidth=1;
    ctx.setLineDash([5,9]); ctx.lineDashOffset=-(Date.now()/60)%14;
    ctx.beginPath();
    path.forEach((p,i)=>{const px=p.x*CELL+CELL/2,py=p.y*CELL+CELL/2;i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);});
    ctx.stroke(); ctx.setLineDash([]);
  }
  // Dynamic agents
  dynAgents.forEach(a=>{
    a.x+=a.vx; a.y+=a.vy;
    if(a.x<0||a.x>COLS)a.vx*=-1;
    if(a.y<0||a.y>ROWS)a.vy*=-1;
    ctx.fillStyle='rgba(200,79,200,0.7)';
    ctx.beginPath();ctx.arc(a.x*CELL+CELL/2,a.y*CELL+CELL/2,CELL*0.45,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='#c84fc8'; ctx.lineWidth=1; ctx.stroke();
  });
  // Goal
  const gx=goal.x*CELL+CELL/2,gy=goal.y*CELL+CELL/2;
  ctx.strokeStyle='#c84fc8'; ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(gx,gy-CELL);ctx.lineTo(gx,gy+CELL);ctx.stroke();
  ctx.beginPath();ctx.moveTo(gx-CELL,gy);ctx.lineTo(gx+CELL,gy);ctx.stroke();
  ctx.fillStyle='#c84fc8';ctx.beginPath();ctx.arc(gx,gy,5,0,Math.PI*2);ctx.fill();
  // LiDAR
  const rx2=robot.x*CELL+CELL/2,ry2=robot.y*CELL+CELL/2;
  if(showLidar){
    ctx.strokeStyle='rgba(57,135,229,0.12)'; ctx.lineWidth=0.8;
    for(let a2=0;a2<24;a2++){
      const ang=robot.angle+a2/24*Math.PI*2;
      let rl=120;
      for(let t=4;t<120;t+=3){
        const lx=Math.floor(robot.x+Math.cos(ang)*t/CELL),ly=Math.floor(robot.y+Math.sin(ang)*t/CELL);
        if(lx>=0&&lx<COLS&&ly>=0&&ly<ROWS&&grid[ly][lx]){rl=t;break;}
      }
      ctx.beginPath();ctx.moveTo(rx2,ry2);ctx.lineTo(rx2+Math.cos(ang)*rl,ry2+Math.sin(ang)*rl);ctx.stroke();
    }
  }
  // Safety ring
  if(showSafety){
    ctx.strokeStyle='rgba(255,255,255,0.05)'; ctx.lineWidth=1; ctx.setLineDash([3,3]);
    ctx.beginPath();ctx.arc(rx2,ry2,rRadius*2,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
  }
  // Robot
  ctx.save();ctx.translate(rx2,ry2);ctx.rotate(robot.angle);
  ctx.fillStyle='#ffffff';
  ctx.beginPath();ctx.moveTo(rRadius,0);ctx.lineTo(-rRadius,-rRadius*0.65);ctx.lineTo(-rRadius,rRadius*0.65);ctx.closePath();ctx.fill();
  ctx.strokeStyle='rgba(57,135,229,0.8)';ctx.lineWidth=1.5;ctx.stroke();
  ctx.restore();
  // Velocity arrow
  if(Math.abs(robot.vx)>0.005||Math.abs(robot.vy)>0.005){
    ctx.strokeStyle='rgba(27,175,122,0.6)';ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(rx2,ry2);ctx.lineTo(rx2+robot.vx*18,ry2+robot.vy*18);ctx.stroke();
  }
  // Frame counter
  document.getElementById('frame-ctr').textContent=Math.min(frameStep||explored.length,explored.length);
}

// ===================== PID =====================
const pid = {kp:2.0,ki:0.15,kd:0.5,sp:0.6,pv:-0.7,integ:0,prevErr:0,out:0,dist:0,noisy:false,mode:'pid'};
let pidHist = [], pidR = {x:0,y:0,angle:0};
let pidMeta = {maxPV:-Infinity,settled:false,stTime:null,rsTime:null,rsAch:false};
const MAX_H=220;

function initPID(){
  pid.pv=-0.7;pid.integ=0;pid.prevErr=0;pidHist=[];
  pidMeta={maxPV:-Infinity,settled:false,stTime:null,rsTime:null,rsAch:false};
  pidR={x:W/2,y:H/2,angle:0};
}

function resetPID(){pid.integ=0;pid.prevErr=0;}
function resetPIDMeta(){pidMeta={maxPV:-Infinity,settled:false,stTime:null,rsTime:null,rsAch:false};}

function stepPID(dt){
  const err=pid.sp-pid.pv;
  const noise=pid.noisy?(Math.random()-.5)*0.06:0;
  const me=err+noise;
  let u=0;
  if(pid.mode==='p'||pid.mode==='pd'||pid.mode==='pid'||pid.mode==='lqr') u+=pid.kp*me;
  if(pid.mode==='pi'||pid.mode==='pid'){pid.integ+=me*dt;u+=pid.ki*Math.max(-2.5,Math.min(2.5,pid.integ));}
  if(pid.mode==='pd'||pid.mode==='pid'){u+=pid.kd*(me-pid.prevErr)/Math.max(dt,0.001);}
  if(pid.mode==='lqr'){u=pid.kp*me+pid.kd*(me-pid.prevErr)/Math.max(dt,0.001);}
  pid.prevErr=me;
  pid.out=Math.max(-1,Math.min(1,u));
  // 2nd order plant
  pid.pv+=(pid.out*0.85-(pid.pv)*0.3)*dt*2.5+pid.dist*dt*4+noise*0.1;
  pid.dist*=0.9;
  pidR.x=W/2+pid.pv*W*0.3;
  pidR.y=H/2-pid.pv*H*0.3;
  pidR.angle=pid.out*Math.PI/4;
  pidHist.push({sp:pid.sp,pv:pid.pv,out:pid.out,err:me});
  if(pidHist.length>MAX_H) pidHist.shift();
  if(pid.pv>pidMeta.maxPV) pidMeta.maxPV=pid.pv;
  if(!pidMeta.rsAch&&pid.pv>pid.sp*0.9){pidMeta.rsTime=(pidHist.length/60).toFixed(2);pidMeta.rsAch=true;}
  if(Math.abs(err)<0.015&&!pidMeta.settled){pidMeta.settled=true;pidMeta.stTime=(pidHist.length/60).toFixed(2);}
  if(Math.abs(err)>0.04) pidMeta.settled=false;
  const ov=pid.sp>0?Math.max(0,(pidMeta.maxPV-pid.sp)/pid.sp*100):0;
  document.getElementById('p-ov').textContent=ov.toFixed(1)+'%';
  document.getElementById('p-st').textContent=pidMeta.stTime||'—';
  document.getElementById('p-ss').textContent=Math.abs(err).toFixed(3);
  document.getElementById('p-rs').textContent=pidMeta.rsTime||'—';
  document.getElementById('m-e').textContent=err.toFixed(3);
  document.getElementById('m-s').textContent=Math.abs(pid.out).toFixed(2);
}

function drawPID(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d0d12';ctx.fillRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(255,255,255,0.025)';ctx.lineWidth=1;
  for(let x=0;x<W;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=0;y<H;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  // Setpoint
  const spy=H/2-pid.sp*H*0.3;
  ctx.strokeStyle='rgba(57,135,229,0.35)';ctx.lineWidth=1;ctx.setLineDash([6,5]);
  ctx.beginPath();ctx.moveTo(0,spy);ctx.lineTo(W,spy);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='rgba(57,135,229,0.7)';ctx.font='10px monospace';
  ctx.fillText('SP: '+pid.sp.toFixed(2),8,spy-5);
  // Robot
  ctx.save();ctx.translate(pidR.x,pidR.y);ctx.rotate(pidR.angle);
  ctx.fillStyle='#ffffff';
  ctx.beginPath();ctx.moveTo(14,0);ctx.lineTo(-10,-6);ctx.lineTo(-10,6);ctx.closePath();ctx.fill();
  ctx.strokeStyle='#1baf7a';ctx.lineWidth=1.5;ctx.stroke();
  ctx.restore();
  // Error line
  ctx.strokeStyle='rgba(227,73,72,0.4)';ctx.lineWidth=1;ctx.setLineDash([3,4]);
  ctx.beginPath();ctx.moveTo(pidR.x,pidR.y);ctx.lineTo(W/2+pid.sp*W*0.3,spy);ctx.stroke();ctx.setLineDash([]);
}

function drawPIDChart(){
  const n=pidHist.length;
  if(!cctx||!cc||n<2)return;
  const cw=cc.width,ch=cc.height;
  cctx.clearRect(0,0,cw,ch);
  const sy=v=>(ch/2)-(v*ch*0.42);
  // Zero line
  cctx.strokeStyle='rgba(255,255,255,0.08)';cctx.lineWidth=1;
  cctx.beginPath();cctx.moveTo(0,ch/2);cctx.lineTo(cw,ch/2);cctx.stroke();
  // Gridlines
  cctx.strokeStyle='rgba(255,255,255,0.04)';
  for(let v=-0.8;v<=0.8;v+=0.4){cctx.beginPath();cctx.moveTo(0,sy(v));cctx.lineTo(cw,sy(v));cctx.stroke();}
  // SP line
  cctx.strokeStyle='#3987e5';cctx.lineWidth=1;cctx.setLineDash([4,3]);
  cctx.beginPath();cctx.moveTo(0,sy(pid.sp));cctx.lineTo(cw,sy(pid.sp));cctx.stroke();cctx.setLineDash([]);
  // Lines
  const drawL=(key,col,lw)=>{
    cctx.strokeStyle=col;cctx.lineWidth=lw;cctx.beginPath();
    pidHist.forEach((p,i)=>{const x=i/MAX_H*cw;const y=sy(p[key]);i===0?cctx.moveTo(x,y):cctx.lineTo(x,y);});
    cctx.stroke();
  };
  drawL('err','#e34948',1);
  drawL('out','#eda100',1);
  drawL('pv','#1baf7a',2);
}

// ===================== KINEMATICS =====================
const kin={type:'2r',q:[.523,1.047,-.698,0.35],L:[85,65,45,35],ws:true,fr:true,jac:true,traj:true,anim:true,trajectory:[],t:0};

function resetKin(){kin.q=[.523,1.047,-.698,.35];kin.trajectory=[];}

function getFK(){
  const n=kin.type==='scara'?4:kin.type==='3r'?3:2;
  const joints=[{x:W/2,y:H/2}];
  let cum=0;
  for(let i=0;i<n;i++){cum+=kin.q[i];joints.push({x:joints[i].x+kin.L[i]*Math.cos(cum),y:joints[i].y+kin.L[i]*Math.sin(cum)});}
  return joints;
}

function getJacobian(n){
  const J=[];
  let cums=[];let c=0;
  for(let i=0;i<n;i++){c+=kin.q[i];cums.push(c);}
  for(let j=0;j<n;j++){
    let jx=0,jy=0;
    for(let i=j;i<n;i++){jx-=kin.L[i]*Math.sin(cums[i]);jy+=kin.L[i]*Math.cos(cums[i]);}
    J.push({jx,jy});
  }
  return J;
}

function drawKinematics(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d0d12';ctx.fillRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(255,255,255,0.025)';ctx.lineWidth=0.5;
  for(let x=0;x<W;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=0;y<H;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}

  const n=kin.type==='scara'?4:kin.type==='3r'?3:2;
  const joints=getFK();
  const ee=joints[joints.length-1];

  // Workspace
  if(kin.ws){
    const tL=kin.L.slice(0,n).reduce((a,b)=>a+b,0);
    ctx.strokeStyle='rgba(80,80,100,0.18)';ctx.lineWidth=18;
    ctx.beginPath();ctx.arc(W/2,H/2,tL,0,Math.PI*2);ctx.stroke();
    ctx.strokeStyle='rgba(80,80,110,0.3)';ctx.lineWidth=1;ctx.setLineDash([4,4]);
    ctx.beginPath();ctx.arc(W/2,H/2,tL,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
  }

  // Trajectory
  if(kin.traj&&kin.trajectory.length>1){
    ctx.strokeStyle='rgba(237,161,0,0.35)';ctx.lineWidth=1;ctx.setLineDash([2,4]);
    ctx.beginPath();kin.trajectory.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));ctx.stroke();ctx.setLineDash([]);
  }

  // Links
  const cols=['#e34948','#1baf7a','#3987e5','#9055d4'];
  for(let i=0;i<n;i++){
    ctx.strokeStyle=cols[i];ctx.lineWidth=7;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(joints[i].x,joints[i].y);ctx.lineTo(joints[i+1].x,joints[i+1].y);ctx.stroke();
    ctx.strokeStyle='rgba(255,255,255,0.15)';ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(joints[i].x,joints[i].y);ctx.lineTo(joints[i+1].x,joints[i+1].y);ctx.stroke();
  }

  // Frames
  if(kin.fr){
    let cum=0;
    for(let i=0;i<n;i++){
      cum+=kin.q[i];
      const jx=joints[i].x,jy=joints[i].y;
      ctx.strokeStyle='#e34948';ctx.lineWidth=2;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(jx,jy);ctx.lineTo(jx+22*Math.cos(cum),jy+22*Math.sin(cum));ctx.stroke();
      ctx.strokeStyle='#1baf7a';
      ctx.beginPath();ctx.moveTo(jx,jy);ctx.lineTo(jx+22*Math.cos(cum+Math.PI/2),jy+22*Math.sin(cum+Math.PI/2));ctx.stroke();
    }
  }

  // Joints
  joints.forEach((j,i)=>{
    ctx.fillStyle=i===0?'#666':i===joints.length-1?'#eda100':cols[i-1];
    ctx.beginPath();ctx.arc(j.x,j.y,i===0?11:i===joints.length-1?8:7,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.4)';ctx.lineWidth=1.5;ctx.stroke();
  });

  // Jacobian ellipsoid
  const J=getJacobian(n);
  if(kin.jac){
    ctx.strokeStyle='rgba(200,79,200,0.6)';ctx.lineWidth=1.5;ctx.setLineDash([3,2]);
    ctx.beginPath();
    const sc=35;
    for(let a=0;a<Math.PI*2;a+=0.08){
      let vx=0,vy=0;
      J.forEach((col,i)=>{vx+=col.jx*Math.cos(a+i);vy+=col.jy*Math.cos(a+i);});
      const mag=Math.sqrt(vx**2+vy**2)||1;
      const px=ee.x+vx/mag*sc*Math.cos(a),py=ee.y+vy/mag*sc*Math.sin(a);
      a<0.08?ctx.moveTo(px,py):ctx.lineTo(px,py);
    }
    ctx.closePath();ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='rgba(200,79,200,0.08)';ctx.fill();
  }

  // EE glow
  ctx.shadowBlur=12;ctx.shadowColor='#eda100';
  ctx.fillStyle='#eda100';ctx.beginPath();ctx.arc(ee.x,ee.y,6,0,Math.PI*2);ctx.fill();
  ctx.shadowBlur=0;

  // Label
  ctx.fillStyle='rgba(237,161,0,0.8)';ctx.font='11px monospace';
  ctx.fillText(`EE(${(ee.x-W/2).toFixed(0)},${(-(ee.y-H/2)).toFixed(0)})`,ee.x+10,ee.y-8);

  // Update panel
  document.getElementById('j00').textContent=J[0].jx.toFixed(1);
  document.getElementById('j01').textContent=(J[1]||{jx:0}).jx.toFixed(1);
  document.getElementById('j02').textContent=(J[2]||{jx:0}).jx.toFixed(1);
  document.getElementById('j10').textContent=J[0].jy.toFixed(1);
  document.getElementById('j11').textContent=(J[1]||{jy:0}).jy.toFixed(1);
  document.getElementById('j12').textContent=(J[2]||{jy:0}).jy.toFixed(1);
  document.getElementById('ee-pos').textContent=`EE: (${(ee.x-W/2).toFixed(1)}, ${(-(ee.y-H/2)).toFixed(1)})`;
  const jjt=[[0,0],[0,0]];
  J.forEach(c=>{jjt[0][0]+=c.jx**2;jjt[0][1]+=c.jx*c.jy;jjt[1][0]+=c.jy*c.jx;jjt[1][1]+=c.jy**2;});
  const det=jjt[0][0]*jjt[1][1]-jjt[0][1]*jjt[1][0];
  document.getElementById('manip').textContent='μ='+Math.max(0,det).toFixed(0);
}

