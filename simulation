const sw={agents:[],mode:'flock',sep:1.5,ali:1.0,coh:0.8,maxspd:2,vel:true,trails:false,rings:false,target:{x:0,y:0},trailArr:[]};

function initSwarm(n){
  ['sw10','sw50','sw100','sw300'].forEach(id=>document.getElementById(id).classList.remove('on'));
  document.getElementById('sw'+n).classList.add('on');
  sw.agents=Array.from({length:n},(_,i)=>({
    x:W*0.25+Math.random()*W*0.5,y:H*0.25+Math.random()*H*0.5,
    vx:(Math.random()-.5)*1.5,vy:(Math.random()-.5)*1.5,lead:i===0
  }));
  sw.target={x:W*0.7,y:H*0.35};
  sw.trailArr=[];
}

function stepSwarm(){
  const A=sw.agents,N=A.length,pr=65,sr=22,mxF=0.12;
  A.forEach((a,i)=>{
    let sx=0,sy=0,ax=0,ay=0,cx=0,cy=0,nc=0;
    A.forEach((b,j)=>{
      if(i===j)return;
      const dx=b.x-a.x,dy=b.y-a.y,d=Math.sqrt(dx**2+dy**2);
      if(d<pr){nc++;ax+=b.vx;ay+=b.vy;cx+=b.x;cy+=b.y;}
      if(d<sr&&d>0){sx-=dx/d;sy-=dy/d;}
    });
    let fx=0,fy=0;
    if(sx||sy){const m=Math.sqrt(sx**2+sy**2);fx+=(sx/m*sw.maxspd-a.vx)*sw.sep;fy+=(sy/m*sw.maxspd-a.vy)*sw.sep;}
    if(nc>0){ax/=nc;ay/=nc;const m=Math.sqrt(ax**2+ay**2)||1;fx+=(ax/m*sw.maxspd-a.vx)*sw.ali;fy+=(ay/m*sw.maxspd-a.vy)*sw.ali;cx/=nc;cy/=nc;const dx=cx-a.x,dy2=cy-a.y,m2=Math.sqrt(dx**2+dy2**2)||1;fx+=(dx/m2*sw.maxspd-a.vx)*sw.coh;fy+=(dy2/m2*sw.maxspd-a.vy)*sw.coh;}
    // Target
    if(!a.lead&&sw.mode==='leader'){const l=A[0];const ldx=l.x-a.x,ldy=l.y-a.y,ld=Math.sqrt(ldx**2+ldy**2)||1;if(ld>20){fx+=(ldx/ld*sw.maxspd-a.vx)*0.5;fy+=(ldy/ld*sw.maxspd-a.vy)*0.5;}}
    else{const tdx=sw.target.x-a.x,tdy=sw.target.y-a.y,td=Math.sqrt(tdx**2+tdy**2)||1;if(td>12){fx+=(tdx/td*sw.maxspd-a.vx)*0.25;fy+=(tdy/td*sw.maxspd-a.vy)*0.25;}}
    const fm=Math.sqrt(fx**2+fy**2);if(fm>mxF){fx=fx/fm*mxF;fy=fy/fm*mxF;}
    a.vx+=fx;a.vy+=fy;
    const vm=Math.sqrt(a.vx**2+a.vy**2);if(vm>sw.maxspd){a.vx=a.vx/vm*sw.maxspd;a.vy=a.vy/vm*sw.maxspd;}
    if(a.x<15||a.x>W-15)a.vx*=-1;if(a.y<15||a.y>H-15)a.vy*=-1;
    a.x=Math.max(5,Math.min(W-5,a.x+a.vx));a.y=Math.max(5,Math.min(H-5,a.y+a.vy));
  });
  if(sw.trails){sw.agents.forEach(a=>sw.trailArr.push({x:a.x,y:a.y,age:0}));sw.trailArr.forEach(t=>t.age++);sw.trailArr=sw.trailArr.filter(t=>t.age<80);}
}

function drawSwarm(){
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#0d0d12';ctx.fillRect(0,0,W,H);
  if(sw.trails){sw.trailArr.forEach(t=>{ctx.fillStyle=`rgba(57,135,229,${0.08*(1-t.age/80)})`;ctx.beginPath();ctx.arc(t.x,t.y,1.5,0,Math.PI*2);ctx.fill();});}
  // Target rings
  ctx.strokeStyle='rgba(237,161,0,0.35)';ctx.lineWidth=1;
  for(let r=12;r<=48;r+=12){ctx.beginPath();ctx.arc(sw.target.x,sw.target.y,r,0,Math.PI*2);ctx.stroke();}
  ctx.fillStyle='#eda100';ctx.beginPath();ctx.arc(sw.target.x,sw.target.y,5,0,Math.PI*2);ctx.fill();

  sw.agents.forEach(a=>{
    const ang=Math.atan2(a.vy,a.vx);
    if(sw.rings){ctx.strokeStyle='rgba(57,135,229,0.07)';ctx.lineWidth=0.5;ctx.beginPath();ctx.arc(a.x,a.y,22,0,Math.PI*2);ctx.stroke();}
    ctx.save();ctx.translate(a.x,a.y);ctx.rotate(ang);
    ctx.fillStyle=a.lead?'#eda100':'#3987e5';
    ctx.beginPath();ctx.moveTo(7,0);ctx.lineTo(-5,-3.5);ctx.lineTo(-5,3.5);ctx.closePath();ctx.fill();
    if(sw.vel){const sp=Math.sqrt(a.vx**2+a.vy**2);ctx.strokeStyle='rgba(57,135,229,0.35)';ctx.lineWidth=0.8;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(sp*10,0);ctx.stroke();}
    ctx.restore();
  });
  ctx.fillStyle='rgba(255,255,255,0.3)';ctx.font='10px monospace';
  ctx.fillText(`N=${sw.agents.length}  mode=${sw.mode}`,10,H-10);
  document.getElementById('m-x').textContent=sw.agents[0]?sw.agents[0].x.toFixed(0):'—';
  document.getElementById('m-y').textContent=sw.agents[0]?sw.agents[0].y.toFixed(0):'—';
}

// ===================== SLAM =====================
const slam={algo:'pf',range:130,noise:3,nP:80,beams:24,showP:true,showG:true,showW:false,showPth:true,showB:true,
  robot:{x:0,y:0,angle:0,vx:0,vy:0},walls:[],occ:null,path:[],pset:[],timer:0};

function initSLAM(){
  slam.walls=[];slam.path=[];slam.pset=[];
  const gs=20;const gcols=Math.floor(W/gs),grows=Math.floor(H/gs);
  const wp=[{x:3,y:3,w:gcols-6,h:1},{x:3,y:grows-4,w:gcols-6,h:1},{x:3,y:3,w:1,h:grows-7},{x:gcols-4,y:3,w:1,h:grows-7},
    {x:Math.floor(gcols*.25),y:Math.floor(grows*.3),w:Math.floor(gcols*.2),h:1},
    {x:Math.floor(gcols*.55),y:Math.floor(grows*.5),w:1,h:Math.floor(grows*.2)},
    {x:Math.floor(gcols*.6),y:Math.floor(grows*.2),w:Math.floor(gcols*.15),h:1}];
  wp.forEach(w=>{for(let dx=0;dx<w.w;dx++)for(let dy=0;dy<w.h;dy++)slam.walls.push({x:(w.x+dx)*gs,y:(w.y+dy)*gs});});
  slam.occ=Array.from({length:grows+1},()=>new Array(gcols+1).fill(0.5));
  slam.robot={x:W*.15,y:H*.15,angle:.4,vx:1.3,vy:.9};
  slam.pset=Array.from({length:slam.nP},()=>({x:slam.robot.x+(Math.random()-.5)*50,y:slam.robot.y+(Math.random()-.5)*50,angle:slam.robot.angle+(Math.random()-.5)*.4,w:1/slam.nP}));
}

function stepSLAM(){
  const r=slam.robot,mg=25;
  if(r.x<mg||r.x>W-mg)r.vx*=-1.1;
  if(r.y<mg||r.y>H-mg)r.vy*=-1.1;
  slam.walls.forEach(w=>{const d=Math.sqrt((r.x-w.x)**2+(r.y-w.y)**2);if(d<30){r.vx*=-.85;r.vy*=-.85;}});
  r.vx+=(Math.random()-.5)*.12;r.vy+=(Math.random()-.5)*.12;
  const sp=Math.sqrt(r.vx**2+r.vy**2);if(sp>2.5){r.vx/=sp;r.vy/=sp;}
  r.x+=r.vx;r.y+=r.vy;r.angle=Math.atan2(r.vy,r.vx);
  slam.path.push({x:r.x,y:r.y});if(slam.path.length>500)slam.path.shift();
  slam.pset.forEach(p=>{
    p.x+=r.vx+(Math.random()-.5)*slam.noise*.6;
    p.y+=r.vy+(Math.random()-.5)*slam.noise*.6;
    p.angle=r.angle+(Math.random()-.5)*.12;
    const d=Math.sqrt((p.x-r.x)**2+(p.y-r.y)**2);
    p.w=Math.exp(-d*d/(2*slam.noise**2*5));
  });
  const ws=slam.pset.reduce((a,p)=>a+p.w,0)||1;
  slam.pset.forEach(p=>p.w/=ws);
  if(Math.random()<0.05){
    const np=[];
    for(let i=0;i<slam.nP;i++){
      const rv=Math.random();let cw=0,ch=slam.pset[0];
      for(const p of slam.pset){cw+=p.w;if(cw>=rv){ch=p;break;}}
      np.push({x:ch.x+(Math.random()-.5)*slam.noise*2.5,y:ch.y+(Math.random()-.5)*slam.noise*2.5,angle:ch.angle+(Math.random()-.5)*.08,w:1/slam.nP});
    }
    slam.pset=np;
  }
  // Occupancy update
  const gs=20,nr=slam.beams;
  for(let b=0;b<nr;b++){
    const a=r.angle+b/nr*Math.PI*2;
    for(let t=8;t<=slam.range;t+=12){
      const rx=r.x+Math.cos(a)*t,ry=r.y+Math.sin(a)*t;
      const gx=Math.round(rx/gs),gy=Math.round(ry/gs);
      if(gx<0||gy<0||gx>=slam.occ[0].length||gy>=slam.occ.length)break;
      const hit=slam.walls.some(w=>Math.abs(w.x-rx)<14&&Math.abs(w.y-ry)<14);
      slam.occ[gy][gx]=hit?Math.min(.96,slam.occ[gy][gx]+.06):Math.max(.04,slam.occ[gy][gx]-.025);
      if(hit)break;
    }
  }
}

function drawSLAM(){
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#0d0d12';ctx.fillRect(0,0,W,H);
  // Occ grid
  if(slam.showG&&slam.occ){
    const gs=20;
    slam.occ.forEach((row,gy)=>row.forEach((cell,gx)=>{
      if(Math.abs(cell-.5)<0.03)return;
      ctx.fillStyle=cell>.5?`rgba(227,73,72,${(cell-.5)*2*.55})`:`rgba(27,175,122,${(.5-cell)*2*.25})`;
      ctx.fillRect(gx*gs,gy*gs,gs,gs);
    }));
  }
  // True walls
  if(slam.showW){ctx.fillStyle='rgba(255,80,80,0.45)';slam.walls.forEach(w=>ctx.fillRect(w.x-9,w.y-9,18,18));}
  // LiDAR beams
  if(slam.showB){
    const r=slam.robot;
    ctx.strokeStyle='rgba(57,135,229,0.12)';ctx.lineWidth=0.7;
    for(let b=0;b<slam.beams;b++){
      const a=r.angle+b/slam.beams*Math.PI*2;
      ctx.beginPath();ctx.moveTo(r.x,r.y);ctx.lineTo(r.x+Math.cos(a)*slam.range,r.y+Math.sin(a)*slam.range);ctx.stroke();
    }
  }
  // Particles
  if(slam.showP){slam.pset.forEach(p=>{const alpha=Math.min(1,p.w*slam.nP*1.8);ctx.fillStyle=`rgba(57,135,229,${alpha*.7})`;ctx.beginPath();ctx.arc(p.x,p.y,2,0,Math.PI*2);ctx.fill();});}
  // Pose path
  if(slam.showPth&&slam.path.length>1){ctx.strokeStyle='rgba(237,161,0,0.5)';ctx.lineWidth=1.5;ctx.beginPath();slam.path.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));ctx.stroke();}
  // Robot
  const r=slam.robot;
  ctx.save();ctx.translate(r.x,r.y);ctx.rotate(r.angle);
  ctx.fillStyle='#eda100';ctx.beginPath();ctx.moveTo(13,0);ctx.lineTo(-9,-5.5);ctx.lineTo(-9,5.5);ctx.closePath();ctx.fill();
  ctx.strokeStyle='rgba(237,161,0,0.6)';ctx.lineWidth=1.5;ctx.stroke();
  ctx.restore();
  document.getElementById('m-x').textContent=r.x.toFixed(0);
  document.getElementById('m-y').textContent=r.y.toFixed(0);
  document.getElementById('m-h').textContent=(r.angle*180/Math.PI).toFixed(0)+'°';
}

