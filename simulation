    else if(module==='swarm'){sw.target={x:e.clientX-rect.left,y:e.clientY-rect.top};}
  } else {
    if(module==='planner'&&cx>=0&&cy>=0&&cx<COLS&&cy<ROWS){goal={x:cx,y:cy};if(!grid[cy]?.[cx])plan();}
    else if(module==='swarm'){sw.target={x:e.clientX-rect.left,y:e.clientY-rect.top};}
    painting=true;
  }
});
sim.addEventListener('mousemove',e=>{
  if(!painting)return;
  const rect=sim.getBoundingClientRect();
  const cx=Math.floor((e.clientX-rect.left)/CELL),cy=Math.floor((e.clientY-rect.top)/CELL);
  if(module==='planner'&&cx>=0&&cy>=0&&cx<COLS&&cy<ROWS&&!grid[cy]?.[cx]){obstacles.push({x:cx,y:cy});buildGrid();}
});
sim.addEventListener('mouseup',()=>{painting=false;if(module==='planner')plan();});
sim.addEventListener('contextmenu',e=>e.preventDefault());

// ===================== MAIN LOOP =====================
let last=0;
function loop(ts){
  requestAnimationFrame(loop);
  if(paused)return;
  fc++;
  if(ts-ft>1000){fps=fc;fc=0;ft=ts;document.getElementById('m-fps').textContent=fps;}
  const dt=Math.min((ts-last)/1000,.05);last=ts;
  const steps=Math.max(1,Math.round(simSpeed/5));
  for(let i=0;i<steps;i++){
    if(module==='planner')moveRobot();
    else if(module==='pid')stepPID(dt/steps);
    else if(module==='swarm')stepSwarm();
    else if(module==='slam')stepSLAM();
    else if(module==='kinematics'&&kin.anim){
      kin.t+=dt/steps;
      kin.q[0]=.5+Math.sin(kin.t*.4)*.8;
      kin.q[1]=.8+Math.sin(kin.t*.6+1)*.7;
      if(kin.type!=='2r')kin.q[2]=-.5+Math.sin(kin.t*.5+2)*.6;
      if(kin.type==='scara')kin.q[3]=.3+Math.sin(kin.t*.7+3)*.4;
      const j=getFK();const ee=j[j.length-1];
      kin.trajectory.push({x:ee.x,y:ee.y});if(kin.trajectory.length>300)kin.trajectory.shift();
    }
  }
  if(module==='planner'){drawPlanner();}
  else if(module==='pid'){drawPID();drawPIDChart();}
  else if(module==='kinematics'){drawKinematics();}
  else if(module==='swarm'){drawSwarm();}
  else if(module==='slam'){drawSLAM();}
}

// Init
resize();
initPlanner(true);
requestAnimationFrame(loop);
</script>
